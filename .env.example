NUTEE_DATA_DIR=data/product-demo-v1
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Browser uses a public project token only. Leave blank for local mode.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Explicitly confirm this is a dedicated synthetic-data test project.
VITE_POSTHOG_TEST_PROJECT=false
POSTHOG_TEST_PROJECT=false
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_HOST=https://us.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
# Internal endpoints: dev allows local access; staging/production require X-Internal-Token.
APP_ENV=dev
INTERNAL_API_TOKEN=
# Optional separate real project; never reuse the synthetic project ID.
POSTHOG_REAL_API_HOST=https://us.posthog.com
POSTHOG_REAL_PROJECT_ID=
POSTHOG_REAL_PERSONAL_API_KEY=

